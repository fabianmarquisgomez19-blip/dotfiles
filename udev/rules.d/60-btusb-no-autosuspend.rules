# Intel 7260 Bluetooth (8087:07dc): no suspender el dispositivo USB.
# El autosuspend del modulo btusb provoca microcortes y caidas del
# transporte A2DP ("Missing completion reports ... adapter firmware bug?").
# Nota: DEVTYPE es una propiedad udev, no un atributo sysfs; hay que
# matchearla con ENV{DEVTYPE}. Con ATTR{DEVTYPE} udev descarta la regla
# entera en silencio (el atributo no existe).
ACTION=="add|change", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="8087", ATTR{idProduct}=="07dc", TEST=="power/control", ATTR{power/control}="on"
