binds {

    // ────────────── Keybindings ──────────────
    // https://github.com/YaLTeR/niri/wiki/Configuration:-Key-Bindings
    //
    // DMS gestiona los keybinds base en dms/binds.kdl (incluido después en
    // config.kdl, así que tiene prioridad). Aquí solo quedan los binds
    // propios que DMS no genera.

    // ─── DMS keybinds ───
    // https://danklinux.com/docs/dankmaterialshell/keybinds-ipc
    // https://danklinux.com/docs/dankmaterialshell/compositors

    Mod+Shift+ESCAPE                     { show-hotkey-overlay; }

    // ─── Applications ───
    Mod+B                               hotkey-overlay-title="Open Browser: firefox" { spawn "firefox"; }

    // --- DMS ---
    Mod+Shift+Return                    hotkey-overlay-title="Wallpaper: DMS dash" { spawn "dms" "ipc" "call" "dash" "toggle" "wallpaper"; }
    Mod+S                               hotkey-overlay-title="Control Center: DMS control-center" { spawn "dms" "ipc" "call" "control-center" "toggle"; }
    Mod+Shift+S                         hotkey-overlay-title="Settings: DMS settings" { spawn "dms" "ipc" "call" "settings" "focusOrToggle"; }
    Mod+CTRL+Return                     hotkey-overlay-title="App Launcher: DMS spotlight" { spawn "dms" "ipc" "call" "spotlight" "toggle"; }
    Mod+Shift+Q                         hotkey-overlay-title="Powermenu: DMS powermenu" { spawn "dms" "ipc" "call" "powermenu" "toggle"; }
    Mod+Shift+M                         hotkey-overlay-title="Task Manager: DMS processlist" { spawn "dms" "ipc" "call" "processlist" "focusOrToggle"; }

    // Please set the text editor of your choice.
    // Mod+Shift+E                               hotkey-overlay-title="Open Text Editor: Zed" { spawn "zed"; }

    // Please choose your own file manager.
    Mod+E                               hotkey-overlay-title="File Manager: DMS Files" { spawn "dfiles" "toggle"; }

    // ─── Layout Controls ───
    Mod+Ctrl+Shift+R                    { switch-preset-window-height; }

    // ─── Mouse Wheel Navigation ───
    Mod+WheelScrollDown                 cooldown-ms=150 { focus-column-right; }
    Mod+WheelScrollUp                   cooldown-ms=150 { focus-column-left; }

    Mod+WheelScrollRight                { focus-column-right; }
    Mod+WheelScrollLeft                 { focus-column-left; }

    Mod+Shift+WheelScrollDown           cooldown-ms=150 { focus-workspace-down; }
    Mod+Shift+WheelScrollUp             cooldown-ms=150 { focus-workspace-up; }

    // ─── Move to Numbered Workspaces ───
    Mod+CTRL+1                          { move-column-to-workspace 1; }
    Mod+CTRL+2                          { move-column-to-workspace 2; }
    Mod+CTRL+3                          { move-column-to-workspace 3; }
    Mod+CTRL+4                          { move-column-to-workspace 4; }
    Mod+CTRL+5                          { move-column-to-workspace 5; }
    Mod+CTRL+6                          { move-column-to-workspace 6; }
    Mod+CTRL+7                          { move-column-to-workspace 7; }
    Mod+CTRL+8                          { move-column-to-workspace 8; }
    Mod+CTRL+9                          { move-column-to-workspace 9; }

    // ─── Modes ───
    Mod+T                               { toggle-window-floating; }

    // ─── Screenshots ───
    CTRL+Shift+1                        { screenshot; }
    CTRL+Shift+2                        { screenshot-screen; }
    CTRL+Shift+3                        { screenshot-window; }

    // ─── Exit / Power ───
    CTRL+ALT+Delete                     { quit; } // Also quits Niri
}
