    window-rule {
        geometry-corner-radius 20 // Set every window radius to 20
        clip-to-geometry true
    }

    // Blur desactivado: sin background-effect global.

    // Floating DMS windows are managed in dms/windowrules.kdl (com.danklinux.dms).

    // if you use steam you will probably like these
    window-rule {
        match app-id="steam"
        exclude title=r#"^[Ss]team$"#
        open-floating true
    }

    window-rule {
       match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
       default-floating-position x=10 y=10 relative-to="bottom-right"
       open-focused false
    }

    // Discord / Vesktop: los botones minimizar/maximizar los dibuja la propia app
    // (ventana Electron frameless). Niri no puede quitarlos con window-rule.
    // Solución: en Vesktop Settings desactiva "Discord Titlebar" para usar frame
    // nativo y que aplique prefer-no-csd (sin botones, solo borde de niri).
    window-rule {
        match app-id=r#"^(discord|vesktop)$"#
        open-floating false
        clip-to-geometry true
    }

    layer-rule {
        match namespace="^quickshell$"
        place-within-backdrop true
    }

    layer-rule {
        match namespace="dms:blurwallpaper"
        place-within-backdrop true
    }
