    prefer-no-csd
    screenshot-path null

    environment {
        ELECTRON_OZONE_PLATFORM_HINT "auto"
        QT_QPA_PLATFORM "wayland"
        QT_QPA_PLATFORMTHEME "gtk3"
        QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
        XDG_CURRENT_DESKTOP "niri"
        XDG_SESSION_TYPE "wayland"
    }

    // DMS 2.1.1 deja dms/cursor.kdl vacío (no lo genera al arrancar), así que
    // el cursor se define aquí. Si una versión futura lo rellena, usará los
    // mismos valores de ~/.config/dms/settings.json (Bibata-Modern-Classic, 19).
    cursor {
        xcursor-theme "Bibata-Modern-Classic"
        xcursor-size 19
        hide-when-typing
    }

    blur {
        off
    }

    debug {
        // Allows notification actions and window activation from DMS.
        honor-xdg-activation-with-invalid-serial
    }

    hotkey-overlay {
       skip-at-startup
    }
